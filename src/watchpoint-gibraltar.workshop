rule("0: Contact & Course Info")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Log To Inspector(Custom String("Hello! Welcome to Ballkour's Watchpoint: Gibraltar course!"));
		Log To Inspector(Custom String("This updated version of code \"W1RWY\" is developed by ballmybeloved, with lobby help from Kalaziel64."));
		Log To Inspector(Custom String("This route was slightly adjusted for quality purposes, and also because this map was updated in Feb, 2026."));
		Log To Inspector(Custom String("Discord: ballkour.com/discord"));
		Log To Inspector(Custom String("Found a bug or have a suggestion? Please let us know in our Discord or open an issue at ballkour.com/github!"));
		Log To Inspector(Custom String("Set a top-10 time? Submit a video with your run in our Discord!"));
		Log To Inspector(Custom String("Course playthrough: ballkour.com/run"));
	}
}

rule("1: Settings")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.settings = Array();
		Global.settings[0] = Workshop Setting Toggle(Custom String("Settings"), Custom String("Debug"), False, 1);
		Global.settings[1] = Workshop Setting Toggle(Custom String("Settings"), Custom String("Lobby Stats"), False, 0);
	}
}

rule("2: Leaderboard (LB)")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Global.lb[i]: [0]name [1]time [2]mistakes [3]alignmentSeparator"
		Global.lb = Array();
		Global.lb[1] = Custom String("BALLMYBLOVED, 4:03.09, 7, '         '");
		Global.lb[2] = Custom String("COLDSKIN, 4:30.11, 10, '                  '");
		Global.lb[3] = Custom String("BACKLINEREIN, 4:34.15, 15, '           '");
		Global.lb[4] = Custom String("DVD, 5:02.50, 15, '                             '");
		Global.lb[5] = Custom String("GAMINGCHAIR, 5:08.37, 16, '          '");
		Global.lb[6] = Custom String("CHESSISFUN, 7:54.96, 85, '                '");
		Global.lb[7] = Custom String("PETUNCO, 9:58.47, 65, '                     '");
		Global.lb[8] = Custom String("KINGO, 13:11.17, 174, '                    '");
		Global.lb[9] = Custom String("APPLEJACK, 14:38.48, 152, '             '");
		Global.timeToBeatInMs = 0;
	}
}

