settings
{
	main
	{
		Description: "v1.0.0-rc.3"
		Mode Name: "Ball Parkour ● ballkour.com"
	}

	lobby
	{
		Allow Players Who Are In Queue: Yes
		Map Rotation: Paused
		Match Voice Chat: Enabled
		Max Spectators: 12
		Max Team 1 Players: 12
		Max Team 2 Players: 0
		Return To Lobby: Never
		Swap Teams After Match: No
	}

	modes
	{
		Skirmish
		{
			enabled maps
			{
				Watchpoint: Gibraltar 972777519512099996
			}
		}

		General
		{
			Hero Limit: Off
		}
	}

	heroes
	{
		General
		{
			Wrecking Ball
			{
				Adaptive Shield Cooldown Time: 0%
				Grappling Claw Cooldown Time: 0%
				No Ammunition Requirement: On
				Piledriver Cooldown Time: 0%
				Ultimate Generation - Passive Minefield: 0%
			}

			enabled heroes
			{
				Wrecking Ball
			}
		}
	}
}

variables
{
	global:
		0: lobbySpawn
		1: lobbyText
		2: lobbyEffects
		3: lobbyIcons
		4: hud
		5: cpLocations
		6: cpBounceRings
		7: cpIsGrappleAllowed
		8: timeToBeat
		9: timeToBeatMs

	player:
		0: isLoading
		1: isInLobby
		2: nameplate
		3: nameplateObject
		4: runIsLoaded
		5: hud
		6: runCurrentCp
		7: runMistakes
		8: runTime
		9: runTimeFormatted
		10: hr
		11: remainingSec
		12: min
		13: minText
		14: sec
		15: secText
		16: hundredths
		17: hundredthsText
		18: cpData
		19: cpEffects
		20: cpIcons
		21: runIsPaused
		22: runIsFinished
		23: isInFreemode
		24: freemodeHud
		25: runCompletionText
		26: runCompletionTextActive
		27: ctrlsHud
		28: ctrlsHudActive
		29: cpCtrlsInputLocked
		100: index
}

subroutines
{
	0: loadNameplate
	1: loadLobby
	3: loadCp
	4: newRun
	5: loadHud
	6: formatRunTime
	7: loadCpData
	8: loadCpObjects
	9: cpResetPlayer
	10: unloadCpObjects
	11: unloadHud
	12: loadFreemodeHud
	13: unloadFreemodeHud
	14: loadRunCompletionText
	15: unloadRunCompletionText
	16: loadCtrlsHud
	17: unloadCtrlsHud
}

rule("0: Contact & Course Info")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Log To Inspector(Custom String("Hello! Welcome to Ballkour's Watchpoint: Gibraltar course!"));
		Log To Inspector(Custom String(
			"This updated version of code \"W1RWY\" is developed by ballmybeloved, with lobby help from Kalaziel64."));
		Log To Inspector(Custom String(
			"This route was slightly adjusted for quality purposes, and also because this map was updated in Feb, 2026."));
		Log To Inspector(Custom String("Have issues or feedback? Want to join our Discord or beat the time to beat? Visit ballkour.com!"));
		Log To Inspector(Custom String("Course playthrough: ballkour.com/run"));
		Global.timeToBeat = Custom String("14:38.48");
		Global.timeToBeatMs = 878480;
	}
}

rule("1.1: Initialize Match")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Disable Inspector Recording;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Set Match Time(0);
		Global.lobbyText = Array();
		Global.lobbyEffects = Array();
		Global.lobbyIcons = Array();
	}
}

