rule("4: Lobby")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Global.lobbyData[i]: [0]spawnpoint [1]facing [2]welcomeSignTop [3]welcomeSignBottom [4]welcomeSignSize [5]startRunRing [6]startRunIcon [7]startRunSign [8]resumeRunRing [9]resumeRunIcon [10]resumeRunSign [11]lbSign [12]lbSignTextSize [13]lbPosTextSize [14]statsSign [15]elapsedTime [16]newPlayers [17]rejoins [18]legitRuns [19]totalRunTime [20]totalMistakes [21]avgRunTime [22]avgMistakes"
		Global.lobbyData = Array();
        Global.lobbyData[0] = Vector(112.24, -2, 65.570);
        Global.lobbyData[5] = Vector(103.805, -1.99, 75.480);
        Global.lobbyData[6] = Global.lobbyData[5] + Vector(0, -1, 0);
        Global.lobbyData[7] = Global.lobbyData[5] + Vector(0, 1.5, 0);
        Global.lobbyData[1] = Global.lobbyData[5] + Vector(0, 2.75, 0);
        Global.lobbyData[2] = Global.lobbyData[5] + Vector(0, 4, 0);
        Global.lobbyData[3] = Global.lobbyData[2] + Vector(0, -0.6, 0);
        Global.lobbyData[4] = 1.5;
        Global.lobbyData[8] = Vector(101.36, -1.99, 73.035);
        Global.lobbyData[9] = Global.lobbyData[8] + Vector(0, -1, 0);
        Global.lobbyData[10] = Global.lobbyData[8] + Vector(0, 1.5, 0);
        Global.lobbyData[11] = Vector(99.18, 4.2, 68.07);
        Global.lobbyData[12] = 1.2;
        Global.lobbyData[13] = 0.85;
        Global.lbPos = Array();
        Global.lbPos[1] = Global.lobbyData[11] + Vector(0, -0.65, 0);
        Global.lbPos[2] = Global.lbPos[1] + Vector(0, -0.5, 0) * 1;
        Global.lbPos[3] = Global.lbPos[1] + Vector(0, -0.5, 0) * 2;
        Global.lbPos[4] = Global.lbPos[1] + Vector(0, -0.5, 0) * 3;
        Global.lbPos[5] = Global.lbPos[1] + Vector(0, -0.5, 0) * 4;
        Global.lbPos[6] = Global.lbPos[1] + Vector(0, -0.5, 0) * 5;
        Global.lbPos[7] = Global.lbPos[1] + Vector(0, -0.5, 0) * 6;
        Global.lbPos[8] = Global.lbPos[1] + Vector(0, -0.5, 0) * 7;
        Global.lbPos[9] = Global.lbPos[1] + Vector(0, -0.5, 0) * 8;
        Global.lbPos[10] = Global.lbPos[1] + Vector(0, -0.5, 0) * 9;
        Global.lobbyData[14] = Vector(101.52, Y Component Of(Global.lobbyData[11]), 62.81);
		Global.lobbyData[15] = Global.lobbyData[14] + Vector(0, -0.65, 0);
		Global.lobbyData[16] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 1;
		Global.lobbyData[17] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 2;
		Global.lobbyData[18] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 3;
		Global.lobbyData[19] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 4;
		Global.lobbyData[20] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 5;
		Global.lobbyData[21] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 6;
		Global.lobbyData[22] = Global.lobbyData[15] + Vector(0, Y Component Of(Global.lbPos[10]) - Y Component Of(Global.lobbyData[15]), 0) / 7 * 7;
	}
}

rule("5: Lobby Boundary")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading) == True;
		Event Player.isInLobby == True;
		Distance Between(Position Of(Event Player), Global.lobbyData[0]) > 18;
	}

	actions
	{
		If(Is Firing Secondary(Event Player));
			Set Secondary Fire Enabled(Event Player, False);
			Set Secondary Fire Enabled(Event Player, True);	
			Set Ability Cooldown(Event Player, Button(Secondary Fire), 0.5);
		End;
		Apply Impulse(Event Player, Direction Towards(Position Of(Event Player), Global.lobbyData[0]), 10, To World, Cancel Contrary Motion);
	}
}

rule("6.1: Initialize Match")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Set Match Time(0);
		If(!Global.settings[0]);
			Disable Inspector Recording;
		End;
		If(Global.settings[1]);
			Global.players = Array();
			"Global.lobbyStats[i]: [0]players [1]rejoins [2]legitRuns [3]totalRunTime [4]totalRunTimeFormatted [5]totalMistakes [6]avgRunTime [7]avgRunTimeFormatted [8]avgMistakes"
			Global.lobbyStats = Array();
			Global.lobbyStats[0] = 0;
			Global.lobbyStats[1] = 0;
			Global.lobbyStats[2] = 0;
			Global.lobbyStats[3] = 0;
			Global.lobbyStats[4] = Custom String("00:00.00");
			Global.lobbyStats[5] = 0;
			Global.lobbyStats[6] = 0;
			Global.lobbyStats[7] = Custom String("00:00.00");
			Global.lobbyStats[8] = 0;
		End;
		Call Subroutine(formatTimeToBeat);
	}
}

rule("6.2: Start Elapsed Timer")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.settings[1] == True;
	}

	actions
	{
		Chase Global Variable At Rate(elapsedTime, 14340, 1, Destination and Rate);
		If(!Global.settings[0]);
			Call Subroutine(formatElapsedTime);
			Wait(0.1, Ignore Condition);
			Loop;
		End;
	}
}

rule("7.1: Player Joins")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		Event Player.isLoading = True;
		If(!Array Contains(Global.players, Custom String("{0}", Event Player)));
			If(Event Player == Host Player);
				Global.hostPlayerName = Custom String("{0}", Event Player);
			End;
			Global.lobbyStats[0] += 1;
			Global.players[Count Of(Global.players)] = Custom String("{0}", Event Player);
		Else;
			Global.lobbyStats[1] += 1;
		End;
		Wait Until(Has Spawned(Event Player), 99999999);
		Disable Game Mode HUD(Event Player);
		Disable Kill Feed(Event Player);
		Disable Game Mode In-World UI(Event Player);
		Disable Nameplates(Event Player, All Players(All Teams));
		Disable Nameplates(All Players(All Teams), Event Player);
		Disable Movement Collision With Players(Event Player);
		Wait(0.016, Ignore Condition);
		Call Subroutine(loadLobby);
		Wait(0.1, Ignore Condition);
		Event Player.isLoading = False;
	}
}

rule("7.2: Player Leaves")
{
    event
    {
        Player Left Match;
        All;
        All;
    }

    conditions
    {
        Is Dummy Bot(Event Player) == False;
    }

    actions
    {
        Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(unloadCpObjects);
		Call Subroutine(unloadHud);
		Call Subroutine(unloadFreemodeHud);
		Call Subroutine(unloadRunCompletionText);
		Call Subroutine(unloadCtrlsHud);
    }
}

rule("8: Load Nameplate")
{
	event
	{
		Subroutine;
		loadNameplate;
	}

	actions
	{
		If(Event Player.isInLobby);
			Event Player.nameplate = Custom String("{0}", Event Player);
		Else;
			If(!Event Player.isInFreemode);
				Event Player.nameplate = Custom String("{0} | {1}", Custom String("{0}", Event Player), Event Player.runCurrentCp);
			Else;
				Event Player.nameplate = Custom String("{0} | FREEMODE", Custom String("{0}", Event Player));
			End;
		End;
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element != Event Player), Event Player.nameplate, Event Player, 1, Clip Against Surfaces, Visible To Position and String, Color(White), Default Visibility);
		Event Player.nameplateObject = Last Text ID;
	}
}

rule("9.1: Load Lobby")
{
	event
	{
		Subroutine;
		loadLobby;
	}

	actions
	{
		Teleport(Event Player, Global.lobbyData[0]);
		Event Player.isInLobby = True;
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Global.lobbyData[1]), To World);
		Event Player.isInFreemode = False;
		Set Secondary Fire Enabled(Event Player, True);
		Allow Button(Event Player, Button(Crouch));
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
	}
}

rule("9.2: Load Welcome Area")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("Welcome to"), Global.lobbyData[2], Global.lobbyData[4], Clip Against Surfaces, Visible To, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("Ballkour!"), Global.lobbyData[3], Global.lobbyData[4], Clip Against Surfaces, Visible To, Color(Orange), Default Visibility);
	}
}

rule("9.3: Load Leaderboard Area")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("Leaderboard"), Global.lobbyData[11],  Global.lobbyData[12], Clip Against Surfaces, Visible To, Custom Color(165, 42, 42, 255), Default Visibility);
		For Global Variable(index, 1, 11, 1);
			If(Global.lb[Global.index] != Null);
				Call Subroutine(formatLbString);
				Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Global.lbObjFormatted, Global.lbPos[Global.index], Global.lobbyData[13], Clip Against Surfaces, Visible To, Color(Orange), Default Visibility);
			Else If(Global.lb[Global.index] < 9);
				Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("{0}. ---                                               ({1}-:--.--, {2}-)", Global.index, Icon String(Bolt), Icon String(Skull)), Global.lbPos[Global.index], Global.lobbyData[13], Clip Against Surfaces, Visible To, Color(Orange), Default Visibility);
			Else;
				Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("10. ---                 ({0}-:--.--, {1}-)", Icon String(Bolt), Icon String(Skull)), Global.lbPos[Global.index], Global.lobbyData[13], Clip Against Surfaces, Visible To, Color(Orange), Default Visibility);
			End;
		End;
	}
}

rule("9.3.1: Format Leaderboard String")
{
	event
	{
		Subroutine;
		formatLbString;
	}

	actions
	{
		"Global.lbObj[i]: [0]name [1]time [2]mistakes [3]alignmentSeparator"
		Global.lbObj = String Split(Global.lb[Global.index], Custom String(","));
		Global.lbObj[3] = String Replace(Global.lbObj[3], Custom String("'"), Custom String(""));
		Global.lbObjFormatted = Custom String("{0}. {1}{2}", Global.index, Global.lbObj[0], Global.lbObj[3]);
		Global.lbObjFormatted = Custom String("{0}({1}{2}, ", Global.lbObjFormatted, Icon String(Bolt), Global.lbObj[1]);
		Global.lbObjFormatted = Custom String("{0}{1}{2})", Global.lbObjFormatted, Icon String(Skull), Global.lbObj[2]);
	}
}

rule("9.4.1: Load Start Run Area")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Custom String("New Run"), Global.lobbyData[7], 1, Clip Against Surfaces, Visible To, Color(Turquoise), Default Visibility);
		Create Effect(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Ring, Color(Sky Blue), Global.lobbyData[5], 1.6, Visible To);
		Create Icon(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Global.lobbyData[6], Flag, Visible To, Color(Green), False);
		Create Effect(Filtered Array(All Players(All Teams), Current Array Element.isInLobby), Sparkles, Color(Orange), Global.lobbyData[5] + Vector(0, -0.85, 0), 1.6, Visible To); 
	}
}

rule("9.4.2: Start Run Circle Entry")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInLobby == True;
		Distance Between(Position Of(Event Player), Global.lobbyData[5]) <= 2;
	}

	actions
	{
		Event Player.isInLobby = False;
		Event Player.isLoading = True;
		Call Subroutine(newRun);
		Call Subroutine(loadHud);
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Event Player.isLoading = False;
	}
}

rule("9.5.1: Load Resume Run Area")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create In-World Text(Filtered Array(All Players(All Teams), (Current Array Element.isInLobby && Current Array Element.isRunLoaded && !Current Array Element.isRunFinished)), Custom String("Resume Run"), Global.lobbyData[10], 1, Clip Against Surfaces, Visible To, Color(Turquoise), Default Visibility);
		Create Effect(Filtered Array(All Players(All Teams), (Current Array Element.isInLobby && Current Array Element.isRunLoaded && !Current Array Element.isRunFinished)), Ring, Color(Green), Global.lobbyData[8], 1.6, Visible To);
		Create Icon(Filtered Array(All Players(All Teams), (Current Array Element.isInLobby && Current Array Element.isRunLoaded && !Current Array Element.isRunFinished)), Global.lobbyData[9], Recycle, Visible To, Color(Green), False);
		Create Effect(Filtered Array(All Players(All Teams), (Current Array Element.isInLobby && Current Array Element.isRunLoaded && !Current Array Element.isRunFinished)), Sparkles, Color(Orange), Global.lobbyData[8] + Vector(0, -0.85, 0), 1.6, Visible To);
	}
}

rule("9.5.2: Resume Run Circle Entry")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInLobby == True;
		Event Player.isRunLoaded == True;
		Event Player.isRunFinished == False;
		Distance Between(Position Of(Event Player), Global.lobbyData[10]) <= 2;
	}

	actions
	{
		Event Player.isInLobby = False;
		Event Player.isLoading = True;
		Call Subroutine(cpResetPlayer);
		Call Subroutine(setCpAbilities);
		Call Subroutine(loadCpObjects);
		Call Subroutine(loadHud);
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Global.cps[Event Player.runCurrentCp][6]), To World);
		Event Player.isLoading = False;
	}
}

rule("9.6: Load Lobby Stats")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.settings[1] == True;
	}

	actions
	{
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Stats"), Global.lobbyData[14], 1.2, Clip Against Surfaces, Visible To, Custom Color(165, 42, 42, 255), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Elapsed Time: {0}", !Global.settings[0] ? Global.elapsedTimeFormatted : Global.elapsedTime), Global.lobbyData[15], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("New Players: {0}", Global.lobbyStats[0]), Global.lobbyData[16], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Rejoins: {0}", Global.lobbyStats[1]), Global.lobbyData[17], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Legit Runs: {0}", Global.lobbyStats[2]), Global.lobbyData[18], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Total Run Time: {0}", Global.lobbyStats[4]), Global.lobbyData[19], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Total Mistakes: {0}", Global.lobbyStats[5]), Global.lobbyData[20], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Avg Run Time: {0}", Global.lobbyStats[7]), Global.lobbyData[21], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
		Create In-World Text(Filtered Array(All Players(All Teams), Current Array Element.isInLobby && Custom String("{0}", Current Array Element) == Global.hostPlayerName), Custom String("Total Mistakes: {0}", Global.lobbyStats[8]), Global.lobbyData[22], 0.85, Clip Against Surfaces, Visible To And String, Color(Orange), Default Visibility);
	}
}

rule("10: Clear Unused Variables")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Global.lb = Null;
		Global.lbPos = Null;
		Global.lbObj = Null;
		Global.lbObjFormatted = Null;
	}
}

rule("11.1: Load Global Run HUD")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Left, 0, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Left, 1, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Left, 2, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Left, 3, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Left, 4, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String("ballkour.com"), Top, 0, Null, Null, Custom Color(165, 42, 42, 255), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 0, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 1, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 2, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 3, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 4, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Null, Custom String(" "), Right, 5, Null, Null, Color(White), Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Null, Top, 2, Null, Color(White), Null, Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Null, Top, 3, Null, Color(White), Null, Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Null, Top, 5, Null, Color(White), Null, Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Null, Top, 9, Null, Color(White), Null, Visible To, Default Visibility);
		Create HUD Text(All Players(All Teams), Null, Custom String(" "), Null, Top, 14, Null, Color(White), Null, Visible To, Default Visibility);
	}
}

rule("11.2.1: Load Local Run HUD")
{
	event
	{
		Subroutine;
		loadHud;
	}

	actions
	{
		Event Player.runHud = Array();
		Create HUD Text(Event Player, Null, Null, Custom String("Controls: {0}", Input Binding String(Button(Ultimate))), Left, 4, Null, Null, Color(Orange), String, Default Visibility);
		Event Player.runHud[0] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String("{0}/{1}", Event Player.runCurrentCp, Count Of(Global.cps) - 1), Top, 1, Null, Null, Color(Orange), String, Default Visibility);
		Event Player.runHud[1] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String("{0} {1}", Icon String(Bolt), !Global.settings[0] ? Event Player.runTimeFormatted : Event Player.runTime), Right, 4, Null, Null, Color(Orange), String, Default Visibility);
		Event Player.runHud[2] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String("{0} {1}", Icon String(Skull), Event Player.runMistakes), Right, 6, Null, Null, Color(Orange), String, Default Visibility);
		Event Player.runHud[3] = Last Text ID;
	}
}


rule("11.2.2: Unload Local Run HUD")
{
	event
	{
		Subroutine;
		unloadHud;
	}

	actions
	{
		For Player Variable(Event Player, index, 0, Count Of(Event Player.runHud), 1);
			Destroy HUD Text(Event Player.runHud[Event Player.index]);
		End;
	}
}

rule("12: Initialize New Run")
{
	event
	{
		Subroutine;
		newRun;
	}

	actions
	{
		Event Player.isRunLoaded = False;
		Event Player.isRunLoaded = True;
		Event Player.isRunPaused = True;
		Event Player.isInFreemode = False;
		Event Player.isRunFinished = False;
		Event Player.isRunLegit = True;
		Event Player.runCurrentCp = 0;
		Event Player.runTime = 0;
		Event Player.runTimeFormatted = Custom String("0.00");
		Event Player.runMistakes = 0;
		Call Subroutine(loadCp);
		Wait(0.016, Ignore Condition);
		Call Subroutine(cpResetPlayer);
		Call Subroutine(setCpAbilities);
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Global.cps[Event Player.runCurrentCp][6]), To World);
	}
}


rule("13.1: Load Checkpoint")
{
	event
	{
		Subroutine;
		loadCp;
	}

	actions
	{
		Call Subroutine(unloadCpObjects);
		Call Subroutine(loadCpData);
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			Call Subroutine(loadCpObjects);
		End;
		Call Subroutine(setCpAbilities);
	}
}

rule("13.2: Load Checkpoint Data")
{
	event
	{
		Subroutine;
		loadCpData;
	}

	actions
	{
		"Event Player.cpData[i]: [0]cpLocation [1]cpSize [2]grappleAllowed [3]piledriverAllowed [4]bounceLocation [5]bounceSize [6]nextCpLocation [7]nextCpSize [8]grappling [9]grappleUsed [10]jumping [11]jumped [12]bhopped [13]bounceUsed [14]piledriving [15]deathLocation"		
		Event Player.cpData = Array();
		Event Player.cpData[0] = Global.cps[Event Player.runCurrentCp][0];
		If(Event Player.runCurrentCp == Count Of(Global.cps) - 1);
			Abort;
		End;
		Event Player.cpData[1] = Global.cps[Event Player.runCurrentCp][1];
		Event Player.cpData[2] = Global.cps[Event Player.runCurrentCp][2];
		Event Player.cpData[3] = Global.cps[Event Player.runCurrentCp][3];
		Event Player.cpData[4] = Global.cps[Event Player.runCurrentCp][4];
		Event Player.cpData[5] = Global.cps[Event Player.runCurrentCp][5];
		Event Player.cpData[6] = Global.cps[Event Player.runCurrentCp][6];
		Event Player.cpData[7] = Global.cps[Event Player.runCurrentCp][7];
		Event Player.cpData[9] = False;
		Event Player.cpData[11] = False;
		Event Player.cpData[12] = False;
		Event Player.cpData[13] = False;
	}
}

rule("13.3.1: Load Checkpoint Objects")
{
	event
	{
		Subroutine;
		loadCpObjects;
	}

	actions
	{
		"Event Player.cpEffects[i]: [0]cpRing [1]bounceCpRing [2]nextCpRing [3]nextCpRing"
		Event Player.cpEffects = Array();
		"Event Player.cpIcons[i]: [0]bounceCpJumpIcon [1]nextCpFlag"
		Event Player.cpIcons = Array();
		Create Effect(Event Player, Ring, Color(Green), Event Player.cpData[0], Event Player.cpData[1], Position and Radius);
		Event Player.cpEffects[0] = Last Created Entity;
		If(Event Player.cpData[4] != Null);
			Create Effect(Event Player, Ring, Color(Orange), Event Player.cpData[4], Event Player.cpData[5], Position and Radius);
			Event Player.cpEffects[1] = Last Created Entity;
			Create Icon(Event Player, Event Player.cpData[4], Arrow: Up, Position, Color(Yellow), False);
			Event Player.cpIcons[0] = Last Created Entity;
		End;
		Create Effect(Event Player, Ring, Color(Sky Blue), Event Player.cpData[6], Event Player.cpData[7], Position and Radius);
		Event Player.cpEffects[2] = Last Created Entity;
		Create Icon(Event Player, Event Player.cpData[6] - Vector(0, 0.5, 0), Flag, Position, Color(Green), True);
		Event Player.cpIcons[1] = Last Created Entity;
		Create Effect(Event Player, Light Shaft, Custom Color(72, 127, 163, 0), Event Player.cpData[6], Event Player.cpData[7], Position and Radius);
		Event Player.cpEffects[3] = Last Created Entity;
	}
}

rule("13.3.2: Unload Checkpoint Objects")
{
	event
	{
		Subroutine;
		unloadCpObjects;
	}

	actions
	{
		Destroy Effect(Event Player.cpEffects[0]);
		Destroy Effect(Event Player.cpEffects[1]);
		Destroy Effect(Event Player.cpEffects[2]);
		Destroy Effect(Event Player.cpEffects[3]);
		Destroy Icon(Event Player.cpIcons[0]);
		Destroy Icon(Event Player.cpIcons[1]);
	}
}

rule("13.4: Set Checkpoint Abilities")
{
	event
	{
		Subroutine;
		setCpAbilities;
	}

	actions
	{
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1 && !Event Player.isInFreemode);
			Set Secondary Fire Enabled(Event Player, Event Player.cpData[2]);
			If(!Event Player.cpData[3]);
				Disallow Button(Event Player, Button(Crouch));
			Else;
				Allow Button(Event Player, Button(Crouch));
			End;
		Else;
			Set Secondary Fire Enabled(Event Player, True);
			If(!Event Player.cpData[3]);
				Disallow Button(Event Player, Button(Crouch));
			Else;
				Allow Button(Event Player, Button(Crouch));
			End;
		End;
	}
}

rule("14.1: Start/Resume Run")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInLobby == False;
		Event Player.isInFreemode == False;
		Event Player.isRunPaused == True;
		Event Player.runCurrentCp < Count Of(Global.cps) - 1;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
	}

	actions
	{
		Event Player.isRunPaused = False;
		Chase Player Variable At Rate(Event Player, runTime, 99999999, 1, Destination and Rate);
	}
}

rule("14.2: Update Run Timer Format")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.isTimerActive == False;
		Event Player.isRunPaused == False;
		Event Player.isRunLoaded == True;
		Global.settings[0] == False;
	}

	actions
	{
		Event Player.isTimerActive = True;
		While(!Event Player.isRunPaused);
			Wait(0.016 + Server Load * 0.0008, Ignore Condition);
			Call Subroutine(formatRunTime);
		End;
		Event Player.isTimerActive = False;
	}
}

rule("15.1: Grappling")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Is Button Held(Event Player, Button(Ultimate)) == False;
	}

	actions
	{
		If(Event Player.isInLobby || Event Player.cpData[4] == Null || Event Player.isInFreemode);
			Set Ability Cooldown(Event Player, Button(Secondary Fire), 0);
		Else;
			Event Player.cpData[8] = True;
			Wait Until(!Is Button Held(Event Player, Button(Secondary Fire)) || Speed Of(Event Player) > 5, 99999999);
			If(Speed Of(Event Player) > 5);
				Wait Until(!Is Button Held(Event Player, Button(Secondary Fire)), 8.5);
			End;
			Event Player.cpData[9] = True;
		End;
	}
}

rule("15.2.1: Jumping")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInLobby == False;
		Event Player.isInFreemode == False;
		Is Jumping(Event Player) == True;
	}

	actions
	{
		Event Player.cpData[10] = True;
		Event Player.cpData[11] = True;
		Wait Until(Is On Ground(Event Player), 0.016);
		Event Player.cpData[10] = False;
	}
}

rule("15.2.2: Bhopping")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		Is Jumping(Event Player) == True;
		Event Player.isInFreemode == False;
		Event Player.isInLobby == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
		Distance Between(Position Of(Event Player), Event Player.cpData[6]) >= Event Player.cpData[7];
	}

	actions
	{
		If(!Event Player.cpData[12]);
			Wait Until(Is On Ground(Event Player), 99999999);
			Event Player.cpData[12] = True;
		End;
	}
}

rule("15.3: Piledriving")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Ultimate)) == False;
	}

	actions
	{
		Event Player.cpData[14] = True;
		Wait Until(Is On Ground(Event Player), 99999999);
		Event Player.cpData[14] = False;
	}
}

rule("15.3: Reset Useless Grapple/Jump/Bhop")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Has Status(Event Player, Rooted)) == True;
		(Event Player.cpData[9] || Event Player.cpData[11] || Event Player.cpData[12]) == True;
		Event Player.isInLobby == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) <= Event Player.cpData[1];
	}

	actions
	{
		Wait Until(Is On Ground(Event Player), 99999999);
		If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) <= Event Player.cpData[1]);
			If(Event Player.cpData[2]);
				Event Player.cpData[9] = False;
				Set Secondary Fire Enabled(Event Player, True);
				Set Ability Cooldown(Event Player, Button(Secondary Fire), 0);
			End;
			Event Player.cpData[11] = False;
			Event Player.cpData[12] = False;
			Event Player.cpData[13] = False;
		End;
	}
}

rule("16.1: Checkpoint Mistake: Missed Checkpoint")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.isInFreemode == False;
		(Event Player.cpData[4] == Null || !Event Player.cpData[8] || Event Player.cpData[13]) == True;
		(Is On Ground(Event Player) || (Event Player.cpData[10] && Event Player.cpData[12])) == True;
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Is Dummy Bot(Event Player) == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]; 
		Distance Between(Position Of(Event Player), Event Player.cpData[6]) >= Event Player.cpData[7];
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.runMistakes += 1;
		Call Subroutine(cpResetPlayer);
		If(Event Player.isRunPaused);
			Event Player.isRunPaused = False;
			Chase Player Variable At Rate(Event Player, runTime, 99999999, 1, Destination and Rate);
		End;
		Event Player.isLoading = False;
	}
}

rule("16.2: Checkpoint Mistake: Already Bhopped")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInFreemode == False;
		Is Jumping(Event Player) == True;
		Event Player.cpData[12] == True;
		(Event Player.cpData[4] == Null || !Event Player.cpData[8] || Event Player.cpData[13]) == True;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
		Distance Between(Position Of(Event Player), Event Player.cpData[6]) >= Event Player.cpData[7];
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.runMistakes += 1;
		Call Subroutine(cpResetPlayer);
		Event Player.isLoading = False;
	}
}

rule("16.3: Checkpoint Mistake: Environment Death")
{
	event
	{
		Player Died;
		All;
		All;
	}

	actions
	{
		Event Player.cpData[15] = Position Of(Event Player);
		Event Player.isLoading = True;
		Respawn(Event Player);
		If(!Event Player.isInFreemode);
			Call Subroutine(cpResetPlayer);
			Event Player.runMistakes += 1;
		Else;
			Teleport(Event Player, Nearest Walkable Position(Event Player.cpData[15]));
		End;
		Event Player.isLoading = False;
	}
}

rule("17.1: Bounce Checkpoints: Grapple Use")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.cpData[4] != Null;
		Event Player.cpData[9] == True;
	}

	actions
	{
		Wait Until(!Is Button Held(Event Player, Button(Secondary Fire)), 99999999);
		If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) <= Event Player.cpData[1]);
			Event Player.cpData[8] = False;
			Event Player.cpData[9] = False;
			Set Ability Cooldown(Event Player, Button(Secondary Fire), 0);
		Else;
			Set Ability Cooldown(Event Player, Button(Secondary Fire), 0);
			Set Secondary Fire Enabled(Event Player, False);
			Wait(0.016, Ignore Condition);
		End;
	}
}

rule("17.2: Bounce Checkpoint Mistake: No Grapple")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInFreemode == False;
		Event Player.cpData[4] != Null;
		Event Player.cpData[8] == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.runMistakes += 1;
		Call Subroutine(cpResetPlayer);
		Event Player.isLoading = False;
	}
}

rule("17.3: Bounce Checkpoint Mistake: Too Slow")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.cpData[4] != Null;
		Event Player.cpData[9] == True;
		Event Player.cpData[13] == False;
		Speed Of(Event Player) <= 10;
		Event Player.isInFreemode == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
	}

	actions
	{
		Event Player.runMistakes += 1;
		Event Player.isLoading = True;
		Call Subroutine(cpResetPlayer);
		Event Player.isLoading = False;
	}
}

rule("17.4: Bounce Checkpoint: Bounce Used Properly")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.cpData[4] != Null;
		Is Jumping(Event Player) == True;
		Event Player.isInFreemode == False;
		Distance Between(Position Of(Event Player), Event Player.cpData[4]) <= Event Player.cpData[5];
	}

	actions
	{
		Event Player.cpData[13] = True;
	}
}

rule("17.5: Bounce Checkpoint Mistake: Improperly Airborne")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.isInFreemode == False;
		Event Player.cpData[4] != Null;
		Event Player.cpData[13] == False;
		Is Jumping(Event Player) == True;
		Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1];
		Distance Between(Vector(X Component Of(Position Of(Event Player)), Y Component Of(Event Player.cpData[4]), Z Component Of(Position Of(Event Player))), Event Player.cpData[4]) >= Event Player.cpData[5];
	}

	actions
	{
		Event Player.runMistakes += 1;
		Event Player.isLoading = True;
		Call Subroutine(cpResetPlayer);
		Event Player.isLoading = False;
	}
}

rule("18: Checkpoint Reset Player")
{
	event
	{
		Subroutine;
		cpResetPlayer;
	}

	actions
	{
		Event Player.isLoading = True;
		If(Is Button Held(Event Player, Button(Secondary Fire)));
			Disallow Button(Event Player, Button(Secondary Fire));
			Allow Button(Event Player, Button(Secondary Fire));
		End;
		Teleport(Event Player, Event Player.cpData[0]);
		Apply Impulse(Event Player, Velocity Of(Event Player) * -0.001, 0.001, To World, Cancel Contrary Motion);
		Set Status(Event Player, Null, Rooted, 0.300);
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			If(Event Player.cpData[4] != Null);
				Event Player.cpData[8] = False;
				Event Player.cpData[9] = False;
				Event Player.cpData[13] = False;
				Set Secondary Fire Enabled(Event Player, True);
				Set Ability Cooldown(Event Player, Button(Secondary Fire), 0);
			End;
			Event Player.cpData[11] = False;
			Event Player.cpData[12] = False;
		End;
		Event Player.isLoading = False;
	}
}

rule("19.1: Checkpoint Completed (No Skipping)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading && !Event Player.isInLobby && !Has Status(Event Player, Rooted)) == True;
		Event Player.isRunLoaded == True;
		Event Player.isInFreemode == False;
		Event Player.isRunPaused == False;
		(Is On Ground(Event Player) || Event Player.cpData[10] || (Altitude Of(Event Player) < 0.01 && !Event Player.cpData[14])) == True;
		Distance Between(Position Of(Event Player), Event Player.cpData[6]) <= Event Player.cpData[7];
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.runCurrentCp += 1;
		Call Subroutine(loadCp);
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.isLoading = True;
				Teleport(Event Player, Event Player.cpData[0]);
				Apply Impulse(Event Player, Velocity Of(Event Player) * -0.001, 0.001, To World, Cancel Contrary Motion);
				Event Player.isLoading = False;
			End;
			Play Effect(Event Player, Ring Explosion Sound, Null, Event Player, 100);
		Else;
			Call Subroutine(finalCpReached);
		End;
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Event Player.isLoading = False;
	}
}

rule("19.2: Final Checkpoint Reached")
{
	event
	{
		Subroutine;
		finalCpReached;
	}

	actions
	{
		Play Effect(Event Player, Bad Pickup Effect, Color(Lime Green), Event Player, 200);
		Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		If(!Event Player.isRunFinished);
			Event Player.isRunFinished = True;
			Start Rule(loadRunCompletionText, Restart Rule);
		End;
		Event Player.isInFreemode = True;
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Call Subroutine(unloadFreemodeHud);
		Call Subroutine(loadFreemodeHud);
		If(Is Button Held(Event Player, Button(Ultimate)));
			Call Subroutine(unloadCtrlsHud);
			Call Subroutine(loadCtrlsHud);
		End;
		If(!Event Player.isRunPaused);
			Stop Chasing Player Variable(Event Player, runTime);
			Event Player.isRunPaused = True;
			If(Event Player.isRunLegit);
				If(Global.settings[1]);
					Call Subroutine(updateStats);
				End;
			End;
		End;
	}
}

rule("19.3.1: Load Run Completion Text")
{
	event
	{
		Subroutine;
		loadRunCompletionText;
	}

	actions
	{
		Event Player.runCompletionText = Array();
		Create HUD Text(Event Player, Null, Custom String("Congrats, {0}!", Event Player), Null, Top, 4, Null, Color(Turquoise), Null, None, Default Visibility);
		Event Player.runCompletionText[0] = Last Text ID;
		Call Subroutine(formatRunTime);
		Create HUD Text(Event Player, Null, Custom String("Time: {0}", Event Player.runTimeFormatted), Null, Top, 6, Null, Color(Orange), Null, None, Default Visibility);
		Event Player.runCompletionText[1] = Last Text ID;
		If(Global.timeToBeatInMs == 0);
			Create HUD Text(Event Player, Null, Custom String("(Time to beat: 00:00.00)"), Null, Top, 7, Null, Color(Orange), Null, None, Default Visibility);
			Event Player.runCompletionText[2] = Last Text ID;
		Else;
			Create HUD Text(Event Player, Null, Custom String("(Time to beat: {0})", Global.timeToBeatFormatted), Null, Top, 7, Null, Color(Orange), Null, None, Default Visibility);
			Event Player.runCompletionText[2] = Last Text ID;
		End;
		Create HUD Text(Event Player, Null, Custom String("Mistakes: {0}", Event Player.runMistakes), Null, Top, 8, Null, Color(Orange), Null, None, Default Visibility);
		Event Player.runCompletionText[3] = Last Text ID;
		If(Global.timeToBeatInMs == 0 || Event Player.runTime < Global.timeToBeatInMs / 1000);
			Create HUD Text(Event Player, Null, Custom String("Top-10 time!"), Null, Top, 10, Null, Color(Orange), Null, None, Default Visibility);
			Event Player.runCompletionText[4] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Submit a video of your run"), Null, Top, 11, Null, Custom Color(165, 42, 42, 255), Null, None, Default Visibility);
			Event Player.runCompletionText[5] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("@"), Null, Top, 12, Null, Custom Color(165, 42, 42, 255), Null, None, Default Visibility);
			Event Player.runCompletionText[6] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("ballkour.com"), Null, Top, 13, Null, Custom Color(165, 42, 42, 255), Null, None, Default Visibility);
			Event Player.runCompletionText[7] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Thanks for playing!"), Null, Top, 15, Null, Color(Turquoise), Null, None, Default Visibility);
			Event Player.runCompletionText[8] = Last Text ID;
		End;
		Wait(30, Ignore Condition);
		Call Subroutine(unloadRunCompletionText);
	}
}

rule("19.3.2: Unload Run Completion Text")
{
	event
	{
		Subroutine;
		unloadRunCompletionText;
	}

	actions
	{
		For Player Variable(Event Player, index, 0, Count Of(Event Player.runCompletionText), 1);
			Destroy HUD Text(Event Player.runCompletionText[Event Player.index]);
		End;
	}
}

rule("19.4: Update Lobby Stats With New Run")
{
	event
	{
		Subroutine;
		updateStats;
	}

	actions
	{
		Global.lobbyStats[2] += 1;
		Global.lobbyStats[3] += Event Player.runTime;
		Global.timeToFormat = Global.lobbyStats[3];
		Call Subroutine(formatRunTimeForLobby);
		Global.lobbyStats[4] = Global.timeFormatted;
		Global.lobbyStats[5] += Event Player.runMistakes;
		Global.lobbyStats[6] = Global.lobbyStats[3] / Global.lobbyStats[2];
		Global.timeToFormat = Global.lobbyStats[6];
		Call Subroutine(formatRunTimeForLobby);
		Global.lobbyStats[7] = Global.timeFormatted;
		Global.lobbyStats[8] = Global.lobbyStats[5] / Global.lobbyStats[2];
	}
}

rule("20.1: Controls HUD Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Event Player.isInLobby == False;
	}

	actions
	{
		Call Subroutine(loadCtrlsHud);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 2));
		Wait Until(!Is Button Held(Event Player, Button(Ultimate)) || Event Player.isInLobby, 99999999);
		Call Subroutine(unloadCtrlsHud);
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Ability 2));
	}
}

rule("20.2.1: Load Controls HUD")
{
	event
	{
		Subroutine;
		loadCtrlsHud;
	}

	actions
	{
		Event Player.ctrlsHud = Array();
		Create HUD Text(Event Player, Null, Custom String("Go Back CP:          {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Primary Fire))), Null, Left, 5, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
		Event Player.ctrlsHud[0] = Last Text ID;
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			Create HUD Text(Event Player, Null, Custom String("Skip CP:                   {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Secondary Fire))), Null, Left, 6, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[1] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Restart CP:        {0} (Hold)", Input Binding String(Button(Reload))), Null, Left, 7, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[2] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Restart Run:           {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Reload))), Null, Left, 8, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[3] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Freemode:              {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Interact))), Null, Left, 9, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[4] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Lobby/Pause:         {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Ability 2))), Null, Left, 10, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[5] = Last Text ID;
		Else;
			Create HUD Text(Event Player, Null, Custom String("Restart:                    {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Reload))), Null, Left, 6, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[1] = Last Text ID;
			Create HUD Text(Event Player, Null, Custom String("Lobby:                      {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Ability 2))), Null, Left, 7, Null, Custom Color(165, 42, 42, 255), Null, String, Default Visibility);
			Event Player.ctrlsHud[2] = Last Text ID;
		End;
	}
}

rule("20.2.2: Unload Controls HUD")
{
	event
	{
		Subroutine;
		unloadCtrlsHud;
	}

	actions
	{
		For Player Variable(Event Player, index, 0, Count Of(Event Player.ctrlsHud), 1);
			Destroy HUD Text(Event Player.ctrlsHud[Event Player.index]);
		End;
	}
}

rule("20.3: Go Back Checkpoint Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		(Has Spawned(Event Player) && !Event Player.isLoading) == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Event Player.runCurrentCp > 0;
		Event Player.isInLobby == False;
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.isRunLegit = False;
		If(!Event Player.isRunPaused);
			Stop Chasing Player Variable(Event Player, runTime);
			Event Player.isRunPaused = True;
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.runMistakes += 1;
			End;
		End;
		Event Player.runCurrentCp -= 1;
		If(Event Player.runCurrentCp == Count Of(Global.cps) - 2);
			Call Subroutine(unloadFreemodeHud);
			Call Subroutine(loadFreemodeHud);
			Call Subroutine(unloadCtrlsHud);
			Call Subroutine(loadCtrlsHud);
		End;
		Call Subroutine(loadCp);
		Call Subroutine(cpResetPlayer);
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Event Player.cpData[6]), To World);
		Wait Until(!Is Button Held(Event Player, Button(Ultimate)) || !Is Button Held(Event Player, Button(Primary Fire)), 0.25);
		If(Is Button Held(Event Player, Button(Ultimate)) && Is Button Held(Event Player, Button(Primary Fire)) && Event Player.runCurrentCp > 0);
			Event Player.isLoading = True;
			While(Is Button Held(Event Player, Button(Ultimate)) && Is Button Held(Event Player, Button(Primary Fire)) && Event Player.runCurrentCp > 0);
				Event Player.runCurrentCp -= 1;
				Teleport(Event Player, Global.cps[Event Player.runCurrentCp][0]);
				Wait(0.02, Ignore Condition);
			End;
			Call Subroutine(loadCp);
			Call Subroutine(cpResetPlayer);
			Destroy In-World Text(Event Player.nameplateObject);
			Call Subroutine(loadNameplate);
			Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Event Player.cpData[6]), To World);
		End;
	}
}

rule("20.4: Skip Checkpoint Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Event Player.runCurrentCp < Count Of(Global.cps) - 1;
		Event Player.isInLobby == False;
		(Has Spawned(Event Player) && !Event Player.isLoading) == True;
	}

	actions
	{
		Event Player.isLoading = True;
		Event Player.isRunLegit = False;
		If(!Event Player.isRunPaused);
			Stop Chasing Player Variable(Event Player, runTime);
			Event Player.isRunPaused = True;
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.runMistakes += 1;
			End;
		End;
		Event Player.runCurrentCp += 1;
		Call Subroutine(loadCp);
		Call Subroutine(cpResetPlayer);
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Event Player.cpData[6]), To World);
		Wait Until(!Is Button Held(Event Player, Button(Ultimate)) || !Is Button Held(Event Player, Button(Secondary Fire)), 0.25);
		If(Is Button Held(Event Player, Button(Ultimate)) && Is Button Held(Event Player, Button(Secondary Fire)) && Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			Event Player.isLoading = True;
			While(Is Button Held(Event Player, Button(Ultimate)) && Is Button Held(Event Player, Button(Secondary Fire)) && Event Player.runCurrentCp < Count Of(Global.cps) - 1);
				Event Player.runCurrentCp += 1;
				Teleport(Event Player, Global.cps[Event Player.runCurrentCp][0]);
				Wait(0.02, Ignore Condition);
			End;
			Call Subroutine(loadCp);
			Call Subroutine(cpResetPlayer);
			Destroy In-World Text(Event Player.nameplateObject);
			Call Subroutine(loadNameplate);
			Set Facing(Event Player, Direction Towards(Eye Position(Event Player), Event Player.cpData[6]), To World);
		End;
		If(Event Player.runCurrentCp == Count Of(Global.cps) - 1);
			Call Subroutine(finalCpReached);
		End;
	}
}

rule("20.5: Restart Checkpoint Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Secondary Fire)) == False;
		Event Player.runCurrentCp < Count Of(Global.cps) - 1;
		Event Player.isInLobby == False;
		(Has Spawned(Event Player) && !Event Player.isLoading) == True;
	}

	actions
	{
		Wait Until(!Is Button Held(Event Player, Button(Reload)), 0.2);
		If(!Is Button Held(Event Player, Button(Reload)) && !Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			Abort;
		End;
		If(!Event Player.isRunPaused);
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.runMistakes += 1;
			End;
		End;
		Event Player.isLoading = True;
		Call Subroutine(cpResetPlayer);
	}
}

rule("20.6: Restart Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Reload)) == True;
		Event Player.isInLobby == False;
	}

	actions
	{
		Event Player.isLoading = True;
		Stop Chasing Player Variable(Event Player, runTime);
		Call Subroutine(newRun);
		Call Subroutine(unloadFreemodeHud);
		Call Subroutine(unloadRunCompletionText);
		Call Subroutine(unloadCtrlsHud);
		If(Is Button Held(Event Player, Button(Ultimate)));
			Call Subroutine(loadCtrlsHud);
		End;
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
		Event Player.isLoading = False;
	}
}

rule("20.7.1: Freemode Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Event Player.isInLobby == False;
		Event Player.runCurrentCp < Count Of(Global.cps) - 1;
	}

	actions
	{
		If(!Event Player.isInFreemode);
			Stop Chasing Player Variable(Event Player, runTime);
			Event Player.isRunPaused = True;
			Event Player.isRunLegit = False;
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.runMistakes += 1;
			End;
			Set Secondary Fire Enabled(Event Player, True);
			Event Player.isInFreemode = True;
			Call Subroutine(unloadFreemodeHud);
			Call Subroutine(loadFreemodeHud);
		Else;
			Event Player.isLoading = True;
			Event Player.isInFreemode = False;
			Call Subroutine(unloadFreemodeHud);
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Call Subroutine(cpResetPlayer);
			End;
			Set Secondary Fire Enabled(Event Player, Event Player.cpData[2]);
			If(!Event Player.cpData[3]);
				Disallow Button(Event Player, Button(Crouch));
			Else;
				Allow Button(Event Player, Button(Crouch));
			End;
			Event Player.isLoading = False;
		End;
		Destroy In-World Text(Event Player.nameplateObject);
		Call Subroutine(loadNameplate);
	}
}

rule("20.7.2.1: Load Freemode HUD")
{
	event
	{
		Subroutine;
		loadFreemodeHud;
	}

	actions
	{
		Event Player.freemodeHud = Array();
		Create HUD Text(Event Player, Null, Null, Custom String(" "), Left, 11, Null, Null, Color(White), None, Default Visibility);
		Event Player.freemodeHud[0] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String(" "), Left, 12, Null, Null, Color(White), None, Default Visibility);
		Event Player.freemodeHud[1] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String(" "), Left, 13, Null, Null, Color(White), None, Default Visibility);
		Event Player.freemodeHud[2] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String(" "), Left, 14, Null, Null, Color(White), None, Default Visibility);
		Event Player.freemodeHud[3] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String(" "), Left, 15, Null, Null, Color(White), None, Default Visibility);
		Event Player.freemodeHud[4] = Last Text ID;
		Create HUD Text(Event Player, Null, Null, Custom String("Freemode On"), Left, 16, Null, Null, Color(Orange), None, Default Visibility);
		Event Player.freemodeHud[5] = Last Text ID;
		If(Event Player.runCurrentCp < Count Of(Global.cps) - 1);
			Create HUD Text(Event Player, Null, Null, Custom String("Disable: {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Interact))), Left, 17, Null, Null, Custom Color(165, 42, 42, 255), String, Default Visibility);
			Event Player.freemodeHud[6] = Last Text ID;
		Else;
			Create HUD Text(Event Player, Null, Null, Custom String("Restart: {0} + {1}", Input Binding String(Button(Ultimate)), Input Binding String(Button(Reload))), Left, 17, Null, Null, Custom Color(165, 42, 42, 255), String, Default Visibility);
			Event Player.freemodeHud[6] = Last Text ID;
		End;
	}
}

rule("20.7.3.2: Unload Freemode HUD")
{
	event
	{
		Subroutine;
		unloadFreemodeHud;
	}

	actions
	{
		For Player Variable(Event Player, index, 0, Count Of(Event Player.freemodeHud), 1);
			Destroy HUD Text(Event Player.freemodeHud[Event Player.index]);
		End;
	}
}

rule("20.8: Lobby Input")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Event Player.isInLobby == False;
	}

	actions
	{
		Event Player.isLoading = True;
		If(!Event Player.isRunPaused);
			Stop Chasing Player Variable(Event Player, runTime);
			Event Player.isRunPaused = True;
			If(Distance Between(Position Of(Event Player), Event Player.cpData[0]) >= Event Player.cpData[1]);
				Event Player.runMistakes += 1;
			End;
		End;
		Call Subroutine(unloadCpObjects);
		Call Subroutine(unloadHud);
		Call Subroutine(unloadFreemodeHud);
		Call Subroutine(unloadRunCompletionText);
		Call Subroutine(loadLobby);
		Event Player.isLoading = False;
	}
}

rule("21.1: Format Time To Beat String")
{
	event
	{
		Subroutine;
		formatTimeToBeat;
	}

	actions
	{
		Global.remainingSec = Round To Integer(Global.timeToBeatInMs / 3600000, Down);
		Global.hr = Global.timeToBeatInMs % 3600000;
		Global.min = Round To Integer(Global.hr / 60000, Down);
		Global.sec = Round To Integer(Global.hr % 60000 / 1000, Down);
		Global.hundredths = Round To Integer(Global.timeToBeatInMs % 1000 / 10, Down);
		If(Global.sec < 10);
			Global.secText = Custom String("0{0}", Global.sec);
		Else;
			Global.secText = Custom String("{0}", Global.sec);
		End;
		If(Global.hundredths < 10);
			Global.hundredthsText = Custom String("0{0}", Global.hundredths);
		Else;
			Global.hundredthsText = Custom String("{0}", Global.hundredths);
		End;
		If(Global.min < 10);
			Global.minText = Custom String("0{0}", Global.min);
		Else;
			Global.minText = Custom String("{0}", Global.min);
		End;
		If(Global.remainingSec > 0);
			Global.timeToBeatFormatted = Custom String("{0}:{1}:{2}", Global.remainingSec, Global.minText, Custom String("{0}.{1}", Global.secText, Global.hundredthsText));
		Else If(Global.min > 0);
			Global.timeToBeatFormatted = Custom String("{0}:{1}.{2}", Global.min, Global.secText, Global.hundredthsText);
		Else;
			Global.timeToBeatFormatted = Custom String("{0}.{1}", Global.sec, Global.hundredthsText);
		End;
	}
}

rule("21.2: Format Elapsed Time String")
{
	event
	{
		Subroutine;
		formatElapsedTime;
	}

	actions
	{
		Global.remainingSec = Round To Integer(Global.elapsedTime / 3600, Down);
		Global.hr = Global.elapsedTime % 3600;
		Global.min = Round To Integer(Global.hr / 60, Down);
		Global.sec = Round To Integer(Global.hr % 60, Down);
		Global.hundredths = Round To Integer((Global.elapsedTime - Round To Integer(Global.elapsedTime, Down)) * 100, Down);
		If(Global.sec < 10);
			Global.secText = Custom String("0{0}", Global.sec);
		Else;
			Global.secText = Custom String("{0}", Global.sec);
		End;
		If(Global.hundredths < 10);
			Global.hundredthsText = Custom String("0{0}", Global.hundredths);
		Else;
			Global.hundredthsText = Custom String("{0}", Global.hundredths);
		End;
		If(Global.min < 10);
			Global.minText = Custom String("0{0}", Global.min);
		Else;
			Global.minText = Custom String("{0}", Global.min);
		End;
		If(Global.remainingSec > 0);
			Global.elapsedTimeFormatted = Custom String("{0}:{1}:{2}", Global.remainingSec, Global.minText, Custom String("{0}.{1}", Global.secText, Global.hundredthsText));
		Else If(Global.min > 0);
			Global.elapsedTimeFormatted = Custom String("{0}:{1}.{2}", Global.min, Global.secText, Global.hundredthsText);
		Else;
			Global.elapsedTimeFormatted = Custom String("{0}.{1}", Global.sec, Global.hundredthsText);
		End;
	}
}

rule("21.3: Format Run Time String")
{
	event
	{
		Subroutine;
		formatRunTime;
	}

	actions
	{
		Event Player.remainingSec = Round To Integer(Event Player.runTime / 3600, Down);
		Event Player.hr = Event Player.runTime % 3600;
		Event Player.min = Round To Integer(Event Player.hr / 60, Down);
		Event Player.sec = Round To Integer(Event Player.hr % 60, Down);
		Event Player.hundredths = Round To Integer((Event Player.runTime - Round To Integer(Event Player.runTime, Down)) * 100, Down);
		If(Event Player.sec < 10);
			Event Player.secText = Custom String("0{0}", Event Player.sec);
		Else;
			Event Player.secText = Custom String("{0}", Event Player.sec);
		End;
		If(Event Player.hundredths < 10);
			Event Player.hundredthsText = Custom String("0{0}", Event Player.hundredths);
		Else;
			Event Player.hundredthsText = Custom String("{0}", Event Player.hundredths);
		End;
		If(Event Player.min < 10);
			Event Player.minText = Custom String("0{0}", Event Player.min);
		Else;
			Event Player.minText = Custom String("{0}", Event Player.min);
		End;
		If(Event Player.remainingSec > 0);
			Event Player.runTimeFormatted = Custom String("{0}:{1}:{2}", Event Player.remainingSec, Event Player.minText, Custom String("{0}.{1}", Event Player.secText, Event Player.hundredthsText));
		Else If(Event Player.min > 0);
			Event Player.runTimeFormatted = Custom String("{0}:{1}.{2}", Event Player.min, Event Player.secText, Event Player.hundredthsText);
		Else;
			Event Player.runTimeFormatted = Custom String("{0}.{1}", Event Player.sec, Event Player.hundredthsText);
		End;
	}
}

rule("21.4: Format Total/Avg Run Time For Lobby")
{
	event
	{
		Subroutine;
		formatRunTimeForLobby;
	}

	actions
	{

		Global.remainingSec = Round To Integer(Global.timeToFormat / 3600, Down);
		Global.hr = Global.timeToFormat % 3600;
		Global.min = Round To Integer(Global.hr / 60, Down);
		Global.sec = Round To Integer(Global.hr % 60, Down);
		Global.hundredths = Round To Integer((Global.timeToFormat - Round To Integer(Global.timeToFormat, Down)) * 100, Down);
		If(Global.sec < 10);
			Global.secText = Custom String("0{0}", Global.sec);
		Else;
			Global.secText = Custom String("{0}", Global.sec);
		End;
		If(Global.hundredths < 10);
			Global.hundredthsText = Custom String("0{0}", Global.hundredths);
		Else;
			Global.hundredthsText = Custom String("{0}", Global.hundredths);
		End;
		If(Global.min < 10);
			Global.minText = Custom String("0{0}", Global.min);
		Else;
			Global.minText = Custom String("{0}", Global.min);
		End;
		If(Global.remainingSec > 0);
			Global.timeFormatted = Custom String("{0}:{1}:{2}", Global.remainingSec, Global.minText, Custom String("{0}.{1}", Global.secText, Global.hundredthsText));
		Else If(Global.min > 0);
			Global.timeFormatted = Custom String("{0}:{1}.{2}", Global.min, Global.secText, Global.hundredthsText);
		Else;
			Global.timeFormatted = Custom String("{0}.{1}", Global.sec, Global.hundredthsText);
		End;
	}
}

rule("22.1: Auto-Restart Server")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		"3hr59min in (31min before OW servers auto-shut down. Restarting a minute before to be safe)"
		Global.elapsedTime == 14340;
	}

	actions
	{
		Chase Global Variable At Rate(elapsedTime, 16140, 1, Destination and Rate);
		Big Message(All Players(All Teams), Custom String("Server restart: \n30min"));
		Wait(900, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("Server restart: \n15min"));
		Wait(600, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("Server restart: \n5min"));
		Wait(240, Ignore Condition);
		Big Message(All Players(All Teams), Custom String("Server restart: \n1min"));
		Wait(60, Ignore Condition);
		Restart Match;
	}
}